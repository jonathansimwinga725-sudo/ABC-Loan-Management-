{
  "name": "ABC Loan Management",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000, 4000],
  "portsAttributes": {
    "3000": {
      "label": "ABC Web App",
      "onAutoForward": "openPreview"
    },
    "4000": {
      "label": "ABC API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install"
}
